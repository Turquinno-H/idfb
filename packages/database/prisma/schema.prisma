// ============================================================================
// IDFB ERP — Prisma Schema
// Normalized multi-tenant (multi-company) schema for a Turkish SME ERP.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum CompanyMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WarehouseType {
  MAIN
  RETAIL
  VIRTUAL
  TRANSIT
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum PartyType {
  INDIVIDUAL
  CORPORATE
}

enum ProductType {
  STOCKABLE
  SERVICE
  DIGITAL
  BUNDLE
}

enum BarcodeType {
  EAN13
  EAN8
  CODE128
  UPC
  QR
}

enum PriceListType {
  SALES
  PURCHASE
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  RETURN_IN
  RETURN_OUT
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum PurchaseReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum SalesInvoiceType {
  E_INVOICE
  E_ARCHIVE
  PAPER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  INVOICED
  CANCELLED
  CLOSED
}

enum WaybillDirection {
  OUTBOUND
  INBOUND
}

enum WaybillStatus {
  DRAFT
  ISSUED
  DELIVERED
  CANCELLED
}

enum EDocumentProfile {
  TEMEL_FATURA
  TICARI_FATURA
  IHRACAT
  KAMU
}

enum EDocumentStatus {
  DRAFT
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  FEE
  INTEREST
}

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  PROMISSORY_NOTE
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKEND
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum POSTransactionStatus {
  OPEN
  COMPLETED
  VOIDED
  REFUNDED
}

// ============================================================================
// IDENTITY / AUTH / RBAC
// ============================================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  isActive         Boolean   @default(true)
  isSuperAdmin     Boolean   @default(false)
  locale           String    @default("tr")
  avatarAttachmentId String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  companyMembers   CompanyMember[]
  employee         Employee?
  notifications    Notification[]
  auditLogs        AuditLog[]
  uploadedFiles    Attachment[]      @relation("AttachmentUploadedBy")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  family            String
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  replacedBy        RefreshToken? @relation("RefreshTokenChain", fields: [replacedByTokenId], references: [id])
  replaces          RefreshToken? @relation("RefreshTokenChain")
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Company {
  id                     String             @id @default(uuid())
  name                   String
  legalName              String?
  taxNumber              String             @unique
  taxOffice              String?
  tradeRegistryNumber    String?
  mersisNumber           String?
  addressLine            String?
  city                   String?
  district               String?
  country                String             @default("Türkiye")
  postalCode             String?
  phone                  String?
  email                  String?
  website                String?
  logoAttachmentId       String?
  baseCurrencyId         String
  baseCurrency           Currency           @relation(fields: [baseCurrencyId], references: [id])
  subscriptionPlan       SubscriptionPlan   @default(TRIAL)
  subscriptionStatus     SubscriptionStatus @default(TRIAL)
  trialEndsAt            DateTime?
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  members                CompanyMember[]
  roles                  Role[]
  branches               Branch[]
  warehouses             Warehouse[]
  customers              Customer[]
  suppliers              Supplier[]
  categories             Category[]
  brands                 Brand[]
  units                  Unit[]
  products               Product[]
  priceLists             PriceList[]
  barcodes               Barcode[]
  stockItems             StockItem[]
  stockMovements         StockMovement[]
  stockTransfers         StockTransfer[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  purchaseInvoices       PurchaseInvoice[]
  quotations             Quotation[]
  salesOrders            SalesOrder[]
  salesInvoices          SalesInvoice[]
  waybills               Waybill[]
  cashAccounts           CashAccount[]
  banks                  Bank[]
  bankAccounts           BankAccount[]
  bankTransactions       BankTransaction[]
  paymentMethods         PaymentMethod[]
  collections            Collection[]
  payments               Payment[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  incomeCategories       IncomeCategory[]
  incomes                Income[]
  accounts               Account[]
  costCenters            CostCenter[]
  journalEntries         JournalEntry[]
  departments            Department[]
  jobPositions           JobPosition[]
  employees              Employee[]
  payrolls               Payroll[]
  attendances            Attendance[]
  projects               Project[]
  tasks                  Task[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  settings               CompanySetting[]
  taxRates               TaxRate[]
  posTerminals           POSTerminal[]
  posTransactions        POSTransaction[]
  attachments            Attachment[]

  @@index([taxNumber])
  @@map("companies")
}

model CompanyMember {
  id         String              @id @default(uuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     CompanyMemberStatus @default(INVITED)
  invitedAt  DateTime?
  joinedAt   DateTime?
  createdAt  DateTime            @default(now())

  memberRoles MemberRole[]

  @@unique([companyId, userId])
  @@map("company_members")
}

model Role {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  id              String        @id @default(uuid())
  companyMemberId String
  companyMember   CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyMemberId, roleId])
  @@map("member_roles")
}

// ============================================================================
// ORGANIZATION: BRANCHES / WAREHOUSES
// ============================================================================

model Branch {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  addressLine String?
  city        String?
  district    String?
  phone       String?
  email       String?
  isMain      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouses       Warehouse[]
  cashAccounts     CashAccount[]
  bankAccounts     BankAccount[]
  employees        Employee[]
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  quotations       Quotation[]
  waybills         Waybill[]
  journalEntries   JournalEntry[]
  expenses         Expense[]
  incomes          Income[]
  projects         Project[]
  posTerminals     POSTerminal[]

  @@unique([companyId, code])
  @@map("branches")
}

model Warehouse {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  code        String
  name        String
  type        WarehouseType @default(MAIN)
  addressLine String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  stockItems         StockItem[]
  stockMovements     StockMovement[]
  transfersFrom      StockTransfer[]   @relation("StockTransferFromWarehouse")
  transfersTo        StockTransfer[]   @relation("StockTransferToWarehouse")
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  salesOrders        SalesOrder[]
  waybills           Waybill[]
  posTerminals       POSTerminal[]
  customerDefaults   Customer[]        @relation("CustomerDefaultWarehouse")
  supplierDefaults   Supplier[]        @relation("SupplierDefaultWarehouse")

  @@unique([companyId, code])
  @@map("warehouses")
}

// ============================================================================
// CRM: CUSTOMERS / SUPPLIERS
// ============================================================================

model Customer {
  id                 String    @id @default(uuid())
  companyId           String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                String
  name                String
  type                PartyType @default(CORPORATE)
  taxNumber           String?
  taxOffice           String?
  nationalId          String?
  email               String?
  phone               String?
  website             String?
  currencyId          String
  currency            Currency  @relation(fields: [currencyId], references: [id])
  priceListId         String?
  priceList           PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  defaultWarehouseId  String?
  defaultWarehouse    Warehouse? @relation("CustomerDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  salesRepUserId      String?
  creditLimit         Decimal   @default(0) @db.Decimal(18, 4)
  paymentTermDays     Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  addresses      Address[]
  contacts       Contact[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  salesInvoices  SalesInvoice[]
  waybills       Waybill[]
  collections    Collection[]
  posTransactions POSTransaction[]
  projects       Project[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("customers")
}

model Supplier {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  type               PartyType @default(CORPORATE)
  taxNumber          String?
  taxOffice          String?
  email              String?
  phone              String?
  website            String?
  currencyId         String
  currency           Currency  @relation(fields: [currencyId], references: [id])
  defaultWarehouseId String?
  defaultWarehouse   Warehouse? @relation("SupplierDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  paymentTermDays    Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses        Address[]
  contacts         Contact[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]
  waybills         Waybill[]
  payments         Payment[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("suppliers")
}

model Address {
  id         String      @id @default(uuid())
  type       AddressType @default(OTHER)
  title      String?
  line1      String
  line2      String?
  district   String?
  city       String
  country    String      @default("Türkiye")
  postalCode String?
  isDefault  Boolean     @default(false)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@map("addresses")
}

model Contact {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@map("contacts")
}

// ============================================================================
// CATALOG: CATEGORIES / BRANDS / UNITS / PRODUCTS / PRICE LISTS / BARCODES
// ============================================================================

model Category {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  name      String
  code      String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  products Product[]

  @@unique([companyId, name])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products Product[]

  @@unique([companyId, name])
  @@map("brands")
}

model Unit {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products Product[]
  barcodes Barcode[]

  @@unique([companyId, code])
  @@map("units")
}

model Product {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  description     String?
  type            ProductType @default(STOCKABLE)
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId         String?
  brand           Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitId          String
  unit            Unit        @relation(fields: [unitId], references: [id])
  taxRateId       String?
  taxRate         TaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  currencyId      String
  currency        Currency    @relation(fields: [currencyId], references: [id])
  purchasePrice   Decimal     @default(0) @db.Decimal(18, 4)
  salesPrice      Decimal     @default(0) @db.Decimal(18, 4)
  minStockLevel   Decimal?    @db.Decimal(18, 4)
  trackBatch      Boolean     @default(false)
  trackSerial     Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  barcodes            Barcode[]
  priceListItems      PriceListItem[]
  stockItems          StockItem[]
  stockMovements      StockMovement[]
  stockTransferLines  StockTransferLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  quotationLines      QuotationLine[]
  salesOrderLines     SalesOrderLine[]
  salesInvoiceLines   SalesInvoiceLine[]
  waybillLines        WaybillLine[]
  posTransactionLines POSTransactionLine[]
  attachments         Attachment[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

model Barcode {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit        @relation(fields: [unitId], references: [id])
  code      String      @unique
  type      BarcodeType @default(EAN13)
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@map("barcodes")
}

model PriceList {
  id         String        @id @default(uuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  type       PriceListType @default(SALES)
  currencyId String
  currency   Currency      @relation(fields: [currencyId], references: [id])
  isDefault  Boolean       @default(false)
  validFrom  DateTime?
  validTo    DateTime?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  items     PriceListItem[]
  customers Customer[]

  @@unique([companyId, name])
  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(18, 4)
  minQuantity Decimal   @default(1) @db.Decimal(18, 4)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ============================================================================
// INVENTORY
// ============================================================================

model StockItem {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand   Decimal   @default(0) @db.Decimal(18, 4)
  quantityReserved Decimal   @default(0) @db.Decimal(18, 4)
  averageCost      Decimal   @default(0) @db.Decimal(18, 4)
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("stock_items")
}

model StockMovement {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(18, 4)
  unitCost      Decimal           @default(0) @db.Decimal(18, 4)
  batchNumber   String?
  serialNumber  String?
  referenceType String?
  referenceId   String?
  note          String?
  movementDate  DateTime          @default(now())
  createdByUserId String?
  createdAt     DateTime          @default(now())

  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockTransfer {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id])
  status          StockTransferStatus @default(DRAFT)
  transferDate    DateTime            @default(now())
  note            String?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  lines StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(18, 4)

  @@map("stock_transfer_lines")
}

// ============================================================================
// PURCHASING
// ============================================================================

model PurchaseOrder {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouseId     String
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  orderNumber     String
  status          PurchaseOrderStatus @default(DRAFT)
  currencyId      String
  currency        Currency            @relation(fields: [currencyId], references: [id])
  exchangeRate    Decimal             @default(1) @db.Decimal(18, 6)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  note            String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lines            PurchaseOrderLine[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]
  waybills         Waybill[]

  @@unique([companyId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String        @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  quantity          Decimal       @db.Decimal(18, 4)
  unitPrice         Decimal       @db.Decimal(18, 4)
  taxRateId         String?
  taxRate           TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  discountRate      Decimal       @default(0) @db.Decimal(9, 4)
  receivedQuantity  Decimal       @default(0) @db.Decimal(18, 4)

  purchaseReceiptLines PurchaseReceiptLine[]

  @@map("purchase_order_lines")
}

model PurchaseReceipt {
  id              String                @id @default(uuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  receiptNumber   String
