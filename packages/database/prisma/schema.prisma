  createdAt             DateTime      @default(now())

  @@unique([employeeId, period])
  @@map("payrolls")
}

model Attendance {
  id         String           @id @default(uuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@map("attendances")
}

// ============================================================================
// PROJECTS / TASKS
// ============================================================================

model Project {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  code            String
  name            String
  description     String?
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Decimal?      @db.Decimal(18, 4)
  managerUserId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tasks Task[]

  @@unique([companyId, code])
  @@map("projects")
}

model Task {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  assigneeUserId  String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("tasks")
}

// ============================================================================
// NOTIFICATIONS / AUDIT LOGS
// ============================================================================

model Notification {
  id        String    @id @default(uuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// SETTINGS / CURRENCY / TAX
// ============================================================================

model CompanySetting {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("company_settings")
}

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  symbol        String
  decimalPlaces Int      @default(2)
  createdAt     DateTime @default(now())

  companies         Company[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  priceLists        PriceList[]
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  salesInvoices     SalesInvoice[]
  cashAccounts      CashAccount[]
  bankAccounts      BankAccount[]
  collections       Collection[]
  payments          Payment[]
  expenses          Expense[]
  incomes           Income[]
  employees         Employee[]
  exchangeRates     ExchangeRate[]

  @@map("currencies")
}

model ExchangeRate {
  id         String   @id @default(uuid())
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  rateDate   DateTime
  rate       Decimal  @db.Decimal(18, 6)
  source     String?
  createdAt  DateTime @default(now())

  @@unique([currencyId, rateDate])
  @@map("exchange_rates")
}

model TaxRate {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  rate      Decimal  @db.Decimal(9, 4)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products             Product[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  quotationLines       QuotationLine[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  posTransactionLines  POSTransactionLine[]

  @@unique([companyId, name])
  @@map("tax_rates")
}

// ============================================================================
// POS
// ============================================================================

model POSTerminal {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  name        String
  code        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  transactions POSTransaction[]

  @@unique([companyId, code])
  @@map("pos_terminals")
}

model POSTransaction {
  id                String               @id @default(uuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posTerminalId     String
  posTerminal       POSTerminal          @relation(fields: [posTerminalId], references: [id])
  cashierUserId     String
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactionNumber String
  status            POSTransactionStatus @default(OPEN)
  subtotal          Decimal              @default(0) @db.Decimal(18, 4)
  taxTotal          Decimal              @default(0) @db.Decimal(18, 4)
  total             Decimal              @default(0) @db.Decimal(18, 4)
  transactionDate   DateTime             @default(now())
  salesInvoiceId    String?
  salesInvoice      SalesInvoice?        @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())

  lines    POSTransactionLine[]
  payments POSTransactionPayment[]

  @@unique([companyId, transactionNumber])
  @@map("pos_transactions")
}

model POSTransactionLine {
  id               String         @id @default(uuid())
  posTransactionId String
  posTransaction   POSTransaction @relation(fields: [posTransactionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Decimal        @db.Decimal(18, 4)
  unitPrice        Decimal        @db.Decimal(18, 4)
  taxRateId        String?
  taxRate          TaxRate?       @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  discountRate     Decimal        @default(0) @db.Decimal(9, 4)

  @@map("pos_transaction_lines")
}

model POSTransactionPayment {
  id                String         @id @default(uuid())
  posTransactionId  String
  posTransaction    POSTransaction @relation(fields: [posTransactionId], references: [id], onDelete: Cascade)
  paymentMethodId   String
  paymentMethod     PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  amount            Decimal        @db.Decimal(18, 4)

  @@map("pos_transaction_payments")
}

// ============================================================================
// FILES / ATTACHMENTS
// ============================================================================

model Attachment {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  mimeType         String
  size             Int
  storageKey       String
  storageBucket    String
  checksum         String?
  entityType       String?
  entityId         String?
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  uploadedByUserId String?
  uploadedBy       User?    @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}
