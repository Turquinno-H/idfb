{
  "name": "idfb-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma:validate": "pnpm --filter @idfb/database exec prisma validate",
    "prisma:generate": "pnpm --filter @idfb/database exec prisma generate",
    "prisma:migrate": "pnpm --filter @idfb/database exec prisma migrate dev",
    "prisma:deploy": "pnpm --filter @idfb/database exec prisma migrate deploy",
    "prisma:seed": "pnpm --filter @idfb/database exec prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "argon2",
      "sharp",
      "msgpackr-extract",
      "unrs-resolver",
      "@scarf/scarf"
    ]
  }
}
